pipeline {

    agent any

    parameters {
        choice(
            name: 'ACTION',
            choices: [
                'Deploy Application',
                'Deploy Database',
                'Remove Application',
                'Remove Database'
            ],
            description: 'Select the operation to perform'
        )
    }


    stages {

        stage('Execute Kubernetes Operation') {

            steps {

                script {

                    if (params.ACTION == 'Deploy Database') {

                        sh '''
                        echo "Creating Namespace..."
                        kubectl apply -f kubernetes/namespace.yml

                        echo "Creating MySQL Service..."
                        kubectl apply -f kubernetes/mysql-service.yml

                        echo "Creating MySQL StatefulSet..."
                        kubectl apply -f kubernetes/mysql-statefulset.yml
                        '''


                    } else if (params.ACTION == 'Deploy Application') {


                        sh '''
                        echo "Creating Namespace..."
                        kubectl apply -f kubernetes/namespace.yml

                        echo "Deploying Spring Boot Application..."
                        kubectl apply -f kubernetes/app-deployment.yml

                        echo "Creating NodePort Service..."
                        kubectl apply -f kubernetes/app-service.yml
                        '''


                    } else if (params.ACTION == 'Remove Application') {


                        sh '''
                        echo "Removing Spring Boot Service..."
                        kubectl delete -f kubernetes/app-service.yml --ignore-not-found=true

                        echo "Removing Spring Boot Deployment..."
                        kubectl delete -f kubernetes/app-deployment.yml --ignore-not-found=true
                        '''


                    } else if (params.ACTION == 'Remove Database') {


                        sh '''
                        echo "Removing MySQL StatefulSet..."
                        kubectl delete -f kubernetes/mysql-statefulset.yml --ignore-not-found=true

                        echo "Removing MySQL Service..."
                        kubectl delete -f kubernetes/mysql-service.yml --ignore-not-found=true
                        '''


                    } else {

                        error "Invalid Action Selected"

                    }
                }
            }
        }


        stage('Verification') {

            steps {

                sh '''

                echo "===== Kubernetes Nodes ====="
                kubectl get nodes


                echo "===== Namespaces ====="
                kubectl get namespaces


                echo "===== Pods in Production ====="
                kubectl get pods -n production


                echo "===== Services in Production ====="
                kubectl get svc -n production

                '''
            }
        }
    }


    post {

        success {
            echo "Kubernetes operation completed successfully."
        }


        failure {
            echo "Kubernetes operation failed."
        }


        always {
            echo "Pipeline execution finished."
        }
    }
}