pipeline {
    agent any

    parameters {
        choice(
            name: 'ACTION',
            choices: [
                'Deploy Application',
                'Deploy Database',
                'Remove Application',
                'Remove Database'
            ],
            description: 'Select the operation to perform'
        )
    }

    stages {

        stage('Execute') {
            steps {
                script {

                    if (params.ACTION == 'Deploy Database') {

                        sh '''
                        echo "Creating Namespace..."
                        kubectl apply -f k8s/namespace.yaml

                        echo "Creating Persistent Volume..."
                        kubectl apply -f k8s/pv.yaml

                        echo "Creating Persistent Volume Claim..."
                        kubectl apply -f k8s/pvc.yaml

                        echo "Deploying MySQL Service..."
                        kubectl apply -f k8s/mysql-service.yaml

                        echo "Deploying MySQL StatefulSet..."
                        kubectl apply -f k8s/mysql-statefulset.yaml
                        '''

                    } else if (params.ACTION == 'Deploy Application') {

                        sh '''
                        echo "Creating Namespace..."
                        kubectl apply -f k8s/namespace.yaml

                        echo "Deploying Spring Boot Application..."
                        kubectl apply -f k8s/app-deployment.yaml

                        echo "Creating NodePort Service..."
                        kubectl apply -f k8s/app-service.yaml
                        '''

                    } else if (params.ACTION == 'Remove Application') {

                        sh '''
                        echo "Removing Spring Boot Application..."
                        kubectl delete -f k8s/app-service.yaml --ignore-not-found=true
                        kubectl delete -f k8s/app-deployment.yaml --ignore-not-found=true
                        '''

                    } else if (params.ACTION == 'Remove Database') {

                        sh '''
                        echo "Removing MySQL..."
                        kubectl delete -f k8s/mysql-statefulset.yaml --ignore-not-found=true
                        kubectl delete -f k8s/mysql-service.yaml --ignore-not-found=true
                        kubectl delete -f k8s/pvc.yaml --ignore-not-found=true
                        kubectl delete -f k8s/pv.yaml --ignore-not-found=true
                        '''

                    } else {
                        error "Invalid Action Selected"
                    }

                }
            }
        }

        stage('Verification') {
            steps {
                sh '''
                echo "===== Nodes ====="
                kubectl get nodes

                echo "===== Namespaces ====="
                kubectl get namespaces

                echo "===== Pods ====="
                kubectl get pods -n production

                echo "===== Services ====="
                kubectl get svc -n production
                '''
            }
        }
    }

    post {

        success {
            echo "Kubernetes operation completed successfully."
        }

        failure {
            echo "Kubernetes operation failed."
        }

        always {
            echo "Pipeline execution finished."
        }
    }
}